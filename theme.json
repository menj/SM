{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "color": "#FFFFFF", "name": "Base", "slug": "base" },
				{ "color": "#202124", "name": "Contrast", "slug": "contrast" },
				{ "color": "#FF0007", "name": "Primary (Red)", "slug": "accent-1" },
				{ "color": "#FDCB30", "name": "Tag (Yellow)", "slug": "accent-2" },
				{ "color": "#FF9797", "name": "Newsletter (Rose)", "slug": "accent-3" },
				{ "color": "#162955", "name": "Link (Navy)", "slug": "accent-4" },
				{ "color": "#F4F4F4", "name": "Surface (Light grey)", "slug": "accent-5" },
				{ "color": "#D2D2D2", "name": "Line (Grey)", "slug": "accent-6" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Lora",
					"slug": "lora",
					"fontFamily": "Lora, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/lora/Lora-VariableFont_wght.woff2" ],
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontFamily": "Lora"
						},
						{
							"src": [ "file:./assets/fonts/lora/Lora-Italic-VariableFont_wght.woff2" ],
							"fontWeight": "400 700",
							"fontStyle": "italic",
							"fontFamily": "Lora"
						}
					]
				}
			],
			"fontSizes": [
				{ "fluid": false, "name": "Tiny", "size": "0.75rem", "slug": "tiny" },
				{ "fluid": false, "name": "Small", "size": "0.875rem", "slug": "small" },
				{ "fluid": { "max": "1.0625rem", "min": "1rem" }, "name": "Medium", "size": "1rem", "slug": "medium" },
				{ "fluid": { "max": "1.375rem", "min": "1.125rem" }, "name": "Large", "size": "1.25rem", "slug": "large" },
				{ "fluid": { "max": "2rem", "min": "1.5rem" }, "name": "Extra Large", "size": "1.75rem", "slug": "x-large" },
				{ "fluid": { "max": "3rem", "min": "2rem" }, "name": "Extra Extra Large", "size": "2.5rem", "slug": "xx-large" }
			]
		},
		"custom": {
			"sm": {
				"radius": { "small": "6px", "medium": "12px", "large": "20px", "pill": "999px" },
				"grid": { "gap": "32px" }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|manrope",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent-4" },
				":hover": { "color": { "text": "var:preset|color|accent-1" } },
				"typography": { "textDecoration": "none" }
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|lora",
					"fontWeight": "400",
					"lineHeight": "1.2"
				},
				"color": { "text": "var:preset|color|contrast" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|base"
				},
				"border": { "radius": "6px" },
				"typography": { "fontWeight": "600", "fontSize": "var:preset|font-size|small" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
				":hover": {
					"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" }
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|lora",
					"fontSize": "1.75rem",
					"fontWeight": "500",
					"lineHeight": "1.05",
					"textTransform": "uppercase",
					"letterSpacing": "0.01em"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						":hover": { "color": { "text": "var:preset|color|accent-1" } }
					}
				}
			},
			"core/post-title": {
				"typography": { "fontFamily": "var:preset|font-family|lora" }
			},
			"core/quote": {
				"typography": { "fontFamily": "var:preset|font-family|lora", "fontStyle": "italic" },
				"color": { "background": "var:preset|color|accent-5" },
				"border": { "radius": "12px", "left": { "color": "var:preset|color|accent-1", "width": "4px" } },
				"spacing": { "padding": { "top": "1.5rem", "bottom": "1.5rem", "left": "1.5rem", "right": "1.5rem" } }
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var:preset|font-family|lora", "fontStyle": "italic", "fontSize": "var:preset|font-size|large" },
				"color": { "background": "var:preset|color|accent-5" },
				"border": { "radius": "12px", "left": { "color": "var:preset|color|accent-1", "width": "4px" } },
				"spacing": { "padding": { "top": "1.5rem", "bottom": "1.5rem", "left": "1.5rem", "right": "1.5rem" } }
			},
			"core/post-terms": {
				"typography": { "fontFamily": "var:preset|font-family|lora", "fontWeight": "700", "fontSize": "var:preset|font-size|small" }
			},
			"core/query-title": {
				"typography": { "fontFamily": "var:preset|font-family|lora", "fontWeight": "400", "fontSize": "var:preset|font-size|xx-large" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|accent-6" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "front-page", "title": "Front Page", "postTypes": [ "page" ] },
		{ "name": "page-about", "title": "About page", "postTypes": [ "page" ] },
		{ "name": "page-contact", "title": "Contact page", "postTypes": [ "page" ] },
		{ "name": "page-donate", "title": "Donate page", "postTypes": [ "page" ] },
		{ "name": "page-legal", "title": "Legal page (with section nav)", "postTypes": [ "page" ] }
	]
}
