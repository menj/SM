{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#1B1A40",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#CE2127",
					"name": "Primary (Red)",
					"slug": "accent-1"
				},
				{
					"color": "#FECD07",
					"name": "Tag (Yellow)",
					"slug": "accent-2"
				},
				{
					"color": "#211F60",
					"name": "Newsletter panel (Navy)",
					"slug": "accent-3"
				},
				{
					"color": "#211F60",
					"name": "Link (Navy)",
					"slug": "accent-4"
				},
				{
					"color": "#F2F3F9",
					"name": "Surface (Light grey)",
					"slug": "accent-5"
				},
				{
					"color": "#DCDDE8",
					"name": "Line",
					"slug": "accent-6"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Sabon Next LT",
					"slug": "sabon-next",
					"fontFamily": "\"Sabon Next LT\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/sabon-next/SabonNextLT-Regular.woff2"
							],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "Sabon Next LT"
						},
						{
							"src": [
								"file:./assets/fonts/sabon-next/SabonNextLT-Italic.woff2"
							],
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontFamily": "Sabon Next LT"
						},
						{
							"src": [
								"file:./assets/fonts/sabon-next/SabonNextLT-Bold.woff2"
							],
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontFamily": "Sabon Next LT"
						},
						{
							"src": [
								"file:./assets/fonts/sabon-next/SabonNextLT-BoldItalic.woff2"
							],
							"fontWeight": "700",
							"fontStyle": "italic",
							"fontFamily": "Sabon Next LT"
						}
					]
				},
				{
					"name": "Kagnue",
					"slug": "kagnue",
					"fontFamily": "Kagnue, \"Sabon Next LT\", Georgia, serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/kagnue/Kagnue-Regular.woff2"
							],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "Kagnue"
						}
					]
				},
				{
					"name": "Kagnue Outline",
					"slug": "kagnue-outline",
					"fontFamily": "\"Kagnue Outline\", Kagnue, serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/kagnue/Kagnue-Outline.woff2"
							],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "Kagnue Outline"
						}
					]
				},
				{
					"name": "Special Elite",
					"slug": "special-elite",
					"fontFamily": "\"Special Elite\", \"Courier New\", monospace",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/special-elite/SpecialElite-Regular.woff2"
							],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "Special Elite"
						}
					]
				},
				{
					"name": "Ferments",
					"slug": "ferments",
					"fontFamily": "Ferments, cursive",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/ferments/Ferments-Regular.woff2"
							],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "Ferments"
						},
						{
							"src": [
								"file:./assets/fonts/ferments/Ferments-Slant.woff2"
							],
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontFamily": "Ferments"
						}
					]
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Tiny",
					"size": "0.75rem",
					"slug": "tiny"
				},
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.0625rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.375rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2rem",
						"min": "1.5rem"
					},
					"name": "Extra Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3rem",
						"min": "2rem"
					},
					"name": "Extra Extra Large",
					"size": "2.5rem",
					"slug": "xx-large"
				}
			]
		},
		"custom": {
			"sm": {
				"radius": {
					"small": "12px",
					"medium": "16px",
					"large": "24px",
					"pill": "999px"
				},
				"grid": {
					"gap": "32px"
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|manrope",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent-4"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent-1"
					}
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|sabon-next",
					"fontWeight": "400",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var:preset|color|contrast"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var:preset|font-size|small"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|kagnue",
					"fontSize": "1.75rem",
					"fontWeight": "400",
					"lineHeight": "1.05",
					"textTransform": "uppercase",
					"letterSpacing": "0.01em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent-1"
							}
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|sabon-next"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|sabon-next",
					"fontStyle": "italic"
				},
				"color": {
					"background": "var:preset|color|accent-5"
				},
				"border": {
					"radius": "24px",
					"left": {
						"color": "var:preset|color|accent-1",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"top": "1.5rem",
						"bottom": "1.5rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|sabon-next",
					"fontStyle": "italic",
					"fontSize": "var:preset|font-size|large"
				},
				"color": {
					"background": "var:preset|color|accent-5"
				},
				"border": {
					"radius": "24px",
					"left": {
						"color": "var:preset|color|accent-1",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"top": "1.5rem",
						"bottom": "1.5rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|sabon-next",
					"fontWeight": "700",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/query-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|sabon-next",
					"fontWeight": "400",
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|accent-6"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "front-page",
			"title": "Front Page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-about",
			"title": "About page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-contact",
			"title": "Contact page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-donate",
			"title": "Donate page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-legal",
			"title": "Legal page (with section nav)",
			"postTypes": [
				"page"
			]
		}
	]
}